diff --git a/candle-nn/tests/rmsnorm_dtype_mismatch_test.rs b/candle-nn/tests/rmsnorm_dtype_mismatch_test.rs
new file mode 100644
index 00000000..94787e71
--- /dev/null
+++ b/candle-nn/tests/rmsnorm_dtype_mismatch_test.rs
@@ -0,0 +1,27 @@
+use candle::{DType, Device, Result, Tensor};
+
+#[test]
+fn test_rmsnorm_mixed_dtype_rocm() -> Result<()> {
+    if !candle::utils::rocm_is_available() {
+        return Ok(());
+    }
+    let dev = Device::new_rocm(0)?;
+
+    // x is F16 (activation), alpha is F32 (layer_norm weight often stored in F32)
+    let x = Tensor::randn(0.0f32, 1.0f32, (1, 16, 128), &dev)?.to_dtype(DType::F16)?;
+    let alpha = Tensor::randn(0.0f32, 1.0f32, (128,), &dev)?.to_dtype(DType::F32)?;
+
+    // This now succeeds transparently on ROCm without panic or manual casts!
+    let out = candle_nn::ops::rms_norm(&x, &alpha, 1e-5)?;
+    println!("rms_norm mixed dtype returned dtype {:?}", out.dtype());
+    assert_eq!(out.dtype(), DType::F16);
+    assert_eq!(out.shape().dims(), &[1, 16, 128]);
+
+    // Also test BF16 + F32
+    let x_bf16 = Tensor::randn(0.0f32, 1.0f32, (1, 16, 128), &dev)?.to_dtype(DType::BF16)?;
+    let out_bf16 = candle_nn::ops::rms_norm(&x_bf16, &alpha, 1e-5)?;
+    assert_eq!(out_bf16.dtype(), DType::BF16);
+
+    println!("SUCCESS: Mixed dtype rms_norm works seamlessly on ROCm!");
+    Ok(())
+}
