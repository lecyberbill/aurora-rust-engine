--- /dev/null
+++ b/candle-core/src/quantized/rocm/autotune.rs
@@ -0,0 +1,35 @@
+//! Per-shape autotune of the batch-1 decode GEMV (dmmv vs mmvq).
+
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock};
+
+use crate::quantized::GgmlDType;
+
+type Key = (u8, usize, usize);
+
+static CACHE: OnceLock<Mutex<HashMap<Key, bool>>> = OnceLock::new();
+static ENABLED: OnceLock<bool> = OnceLock::new();
+
+/// `CANDLE_ROCM_AUTOTUNE=1` enables the per-shape timing pass.
+pub(super) fn enabled() -> bool {
+    *ENABLED.get_or_init(|| match std::env::var("CANDLE_ROCM_AUTOTUNE") {
+        Ok(v) => v != "0" && !v.is_empty(),
+        Err(_) => true,
+    })
+}
+
+/// `Some(true)` = mmvq won, `Some(false)` = dmmv won, `None` = not tuned yet.
+pub(super) fn cached(dtype: GgmlDType, n: usize, k: usize) -> Option<bool> {
+    CACHE
+        .get_or_init(|| Mutex::new(HashMap::new()))
+        .lock()
+        .ok()?
+        .get(&(dtype as u8, n, k))
+        .copied()
+}
+
+pub(super) fn store(dtype: GgmlDType, n: usize, k: usize, prefer_mmvq: bool) {
+    if let Ok(mut m) = CACHE.get_or_init(|| Mutex::new(HashMap::new())).lock() {
+        m.insert((dtype as u8, n, k), prefer_mmvq);
+    }
+}
