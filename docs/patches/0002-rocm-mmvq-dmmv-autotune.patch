         };
 
         let b_size = b * m;
+
+        // Optional per-shape autotune of the batch-1 decode GEMV: time both
+        // kernels once and cache the winner (CANDLE_ROCM_AUTOTUNE=1).
+        if b_size == 1 && autotune::enabled() && dmmv::has_kernel(self.dtype) {
+            let run_mmvq = || -> Result<Option<crate::rocm_backend::SendSyncDeviceMemory<f32>>> {
+                mmvq::try_fwd(self, n, k, b_size, storage, layout, true)
+            };
+            let run_dmmv = || -> Result<Option<crate::rocm_backend::SendSyncDeviceMemory<f32>>> {
+                if let RocmStorageSlice::F32(y) = &storage.slice {
+                    if let Some((o1, o2)) = layout.contiguous_offsets() {
+                        if o2 - o1 == k {
+                            return Ok(Some(dmmv::mul_mat_vec(
+                                &self.data,
+                                self.len,
+                                y,
+                                o1,
+                                self.dtype,
+                                k,
+                                n,
+                                &self.device,
+                            )?));
+                        }
+                    }
+                }
+                Ok(None)
+            };
+
+            if let Some(prefer_mmvq) = autotune::cached(self.dtype, n, k) {
+                if prefer_mmvq {
+                    if let Some(dst) = run_mmvq()? {
+                        return Ok(wrap(dst));
+                    }
+                } else if let Some(dst) = run_dmmv()? {
+                    return Ok(wrap(dst));
+                }
+            } else {
+                let mut mm = None;
+                let mut t_mm = std::time::Duration::MAX;
+                for _ in 0..3 {
+                    let t = std::time::Instant::now();
+                    mm = run_mmvq()?;
+                    self.device.synchronize()?;
+                    t_mm = t_mm.min(t.elapsed());
+                }
+                let mut dm = None;
+                let mut t_dm = std::time::Duration::MAX;
+                for _ in 0..3 {
+                    let t = std::time::Instant::now();
+                    dm = run_dmmv()?;
+                    self.device.synchronize()?;
+                    t_dm = t_dm.min(t.elapsed());
+                }
+                match (mm, dm) {
+                    (Some(m), Some(d)) => {
+                        let prefer = t_mm < t_dm;
+                        autotune::store(self.dtype, n, k, prefer);
+                        eprintln!(
+                            "[rocm autotune] {:?} n={n} k={k}: mmvq={:?} dmmv={:?} -> {}",
+                            self.dtype,
+                            t_mm,
+                            t_dm,
+                            if prefer { "mmvq" } else { "dmmv" }
+                        );
+                        return Ok(wrap(if prefer { m } else { d }));
+                    }
+                    (Some(m), None) => {
+                        autotune::store(self.dtype, n, k, true);
+                        return Ok(wrap(m));
+                    }
+                    (None, Some(d)) => {
+                        autotune::store(self.dtype, n, k, false);
+                        return Ok(wrap(d));
+                    }
+                    (None, None) => {}
+                }
+            }
+        }
+
         if b_size <= mmvq::MAX_BATCH {
-            if let Some(dst) = mmvq::try_fwd(self, n, k, b_size, storage, layout)? {
+            if let Some(dst) = mmvq::try_fwd(self, n, k, b_size, storage, layout, false)? {
                 return Ok(wrap(dst));
             }
         }
diff --git a/candle-core/src/quantized/rocm/autotune.rs b/candle-core/src/quantized/rocm/autotune.rs
