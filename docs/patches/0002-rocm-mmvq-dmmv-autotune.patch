diff --git a/candle-core/src/inplace.rs b/candle-core/src/inplace.rs
new file mode 100644
index 00000000..788fe344
--- /dev/null
+++ b/candle-core/src/inplace.rs
@@ -0,0 +1,70 @@
+//! In-place tensor updates used by the HIP graph decode runner.
+//!
+//! Graph replay bakes in every buffer address, so the per-token inputs (token
+//! embedding, RoPE cos/sin, attention mask, KV scatter index) have to be written
+//! into fixed device buffers instead of allocating fresh tensors.
+
+use crate::backend::BackendStorage;
+use crate::{DType, Result, Tensor};
+
+impl Tensor {
+    /// In-place host-to-device copy into a U32 tensor.
+    #[cfg(feature = "rocm")]
+    pub fn copy_from_host_u32(&self, data: &[u32]) -> Result<()> {
+        if self.dtype() != DType::U32 {
+            crate::bail!(
+                "copy_from_host_u32: tensor is {:?}, expected U32",
+                self.dtype()
+            );
+        }
+        if data.len() != self.elem_count() {
+            crate::bail!(
+                "copy_from_host_u32: {} values for {} elements",
+                data.len(),
+                self.elem_count()
+            );
+        }
+        let (mut storage, _layout) = self.storage_mut_and_layout();
+        match &mut *storage {
+            crate::Storage::Rocm(s) => match &mut s.slice {
+                crate::rocm_backend::RocmStorageSlice::U32(mem) => mem
+                    .copy_from_host(data)
+                    .map_err(|e| crate::Error::Msg(format!("copy_from_host_u32: {e}"))),
+                _ => crate::bail!("copy_from_host_u32: ROCm storage is not U32"),
+            },
+            _ => crate::bail!("copy_from_host_u32: tensor is not on a ROCm device"),
+        }
+    }
+
+    /// In-place device-to-device copy of `src` into `self`.
+    ///
+    /// Both tensors must have the same shape and dtype and live on the same
+    /// device. Used to refresh the static graph input buffers without changing
+    /// their addresses.
+    #[cfg(feature = "rocm")]
+    pub fn copy2(&self, src: &Tensor) -> Result<()> {
+        if self.shape() != src.shape() {
+            crate::bail!(
+                "copy2: shape mismatch {:?} vs {:?}",
+                self.shape(),
+                src.shape()
+            );
+        }
+        if self.dtype() != src.dtype() {
+            crate::bail!(
+                "copy2: dtype mismatch {:?} vs {:?}",
+                self.dtype(),
+                src.dtype()
+            );
+        }
+        if self.same_storage(src) {
+            crate::bail!("copy2: source and destination share storage");
+        }
+        let src_c = src.contiguous()?;
+        let src_layout = src_c.layout().clone();
+        let (mut dst_storage, dst_layout) = self.storage_mut_and_layout();
+        let dst_off = dst_layout.start_offset();
+        let src_storage = src_c.storage();
+        src_storage.copy_strided_src(&mut *dst_storage, dst_off, &src_layout)
+    }
+}
